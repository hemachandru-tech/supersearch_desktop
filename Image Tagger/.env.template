# =============================================================================
#  Super Search — configuration
#  "Install SuperSearch.command" copies this file to ".env" on first run.
#  Edit .env (not this template) and restart the app to apply changes.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Gemini API key for AI tagging
# -----------------------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Supply several comma-separated keys to spread the load across quotas; the app
# rotates through them. GEMINI_API_KEY (singular) is accepted as a fallback.
GEMINI_API_KEYS=YOUR_API_KEY_HERE
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Application window
# -----------------------------------------------------------------------------
# desktop   = chromeless Chrome/Edge app window (default)
# pywebview = native WebView window
# browser   = ordinary browser tab
APP_MODE=desktop
APP_PORT=8765

# -----------------------------------------------------------------------------
# Models
# -----------------------------------------------------------------------------
# Leave these unset to use the models shipped in models/.
# Player recognition resolves in this order:
#   1. the model marked ACTIVE in the app's Player Management screen
#   2. FACE_MODEL_PATH below, if set
#   3. the highest "Player Recognition Model V<n>.joblib" in models/
#   4. models/faces_custom.joblib (legacy fallback)
# FACE_MODEL_PATH=
# JERSEY_MODEL_PATH=

# -----------------------------------------------------------------------------
# Video processing
# -----------------------------------------------------------------------------
VIDEO_FPS_EXTRACT=1.0
# Videos above this size are sampled on a fixed interval instead of by FPS.
LARGE_VIDEO_THRESHOLD_GB=10
LARGE_VIDEO_INTERVAL_SECONDS=60

# Speech-to-text transcript for videos (faster-whisper). Off by default: the
# first run downloads the model and transcription is slow on CPU.
ENABLE_TRANSCRIBE=false
WHISPER_MODEL=large-v3
TRANSCRIBE_LANGUAGE=en
TRANSCRIBE_MAX_CHARS=10000

# -----------------------------------------------------------------------------
# Tagging defaults
# -----------------------------------------------------------------------------
TOURNAMENT_NAME=
DEFAULT_TOURNAMENT=Unknown

# -----------------------------------------------------------------------------
# Optional — Google Drive import
# -----------------------------------------------------------------------------
# OAuth client secrets JSON, used by the Drive downloader.
GOOGLE_CLIENT_SECRET_PATH=models/client.json

# -----------------------------------------------------------------------------
# Optional — remote MySQL mirror (legacy accounting/export path)
# -----------------------------------------------------------------------------
# Leave blank to keep everything local in tags.db.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional SSH tunnel to reach the database above.
SSH_HOST=
SSH_USER=
SSH_PEM_PATH=

# -----------------------------------------------------------------------------
# Optional — Gemini cost reporting (USD per 1K tokens)
# -----------------------------------------------------------------------------
# PRICE_1K_IN=
# PRICE_1K_OUT=
